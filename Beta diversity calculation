meta_cage <- data.frame(
  DietGroup = factor(as.character(sample_data(ps_cage)$diet))
)
pairwise_results_cage <- pairwise.adonis(
  x = as.matrix(dist_cage),
  factors = meta_cage$DietGroup,
  sim.method = "euclidean",
  perm = 999,
  p.adjust.m = "BH"
)
pairwise_results_cage
