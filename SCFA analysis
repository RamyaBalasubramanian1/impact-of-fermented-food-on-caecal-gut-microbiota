#plotting with outlier analysis
# features of interest
keep_features <- c("acetate", "BCFA", "butyrate",
                   "isobutyrate", "isovalerate",
                   "propionate", "SCFA", "valerate")

scfa_sub <- scfa_long %>%
  filter(Feature %in% keep_features)

# 1) Identify outliers
outliers <- scfa_sub %>%
  group_by(Feature, Diet) %>%
  identify_outliers(Concentration)

# 2) Remove outliers (keep only rows not marked as outliers)
scfa_no_outliers <- scfa_sub %>%
  anti_join(outliers %>% filter(is.outlier), 
            by = c("Sample_ID", "Feature", "Diet", "Concentration"))

#but data is not normally dist
# Run Shapiro-Wilk test on residuals for each Feature
shapiro_results <- scfa_no_outliers %>%
  group_by(Feature) %>%
  do({
    # linear model: Concentration ~ Diet
    model <- lm(Concentration ~ Diet, data = .)
    res   <- residuals(model)
    tibble(
      statistic = shapiro.test(res)$statistic,
      p.value   = shapiro.test(res)$p.value
    )
  })

shapiro_results
##################
#shapiro test indicates the data is normally distributed so we use ANOVA
###################
###################
anova_results_raw <- scfa_no_outliers %>%
  group_by(Feature) %>%
  anova_test(Concentration ~ Diet)
anova_results <- get_anova_table(anova_results_raw) %>%  # <- not in a pipe
  as_tibble() %>%                                       # <- drop special class
  filter(Effect == "Diet") %>%
  mutate(
    p.adj  = p.adjust(p, method = "BH"),
    signif = ifelse(p.adj < 0.05, "*", "ns")
  )
sig_features <- anova_results %>%
  filter(p.adj < 0.05) %>%
  pull(Feature) %>%
  unique()
sig_features
tukey_results <- scfa_no_outliers %>%
  filter(Feature %in% sig_features) %>%
  group_by(Feature) %>%
  tukey_hsd(Concentration ~ Diet)
tukey_results
sig_features <- tukey_results %>%
  filter(p.adj < 0.05)

sig_features

##########################
#########################
ann_df <- sig_features[, c("Feature","group1","group2","p.adj","p.adj.signif")] %>%
  dplyr::left_join(
    scfa_no_outliers %>%
      dplyr::group_by(Feature) %>%
      dplyr::summarise(ymax = max(Concentration, na.rm = TRUE), .groups = "drop"),
    by = "Feature"
  ) %>%
  dplyr::group_by(Feature) %>%
  dplyr::arrange(Feature, group1, group2, .by_group = TRUE) %>%
  dplyr::mutate(
    y.position = ymax * 1.10 + (dplyr::row_number() - 1) * (0.08 * ymax)
  ) %>%
  dplyr::ungroup()
p <- ggplot(scfa_no_outliers, aes(x = Diet, y = Concentration, fill = Diet)) +
  geom_boxplot(outlier.shape = NA) +
  geom_jitter(shape = 21, color = "black", width = 0.15, alpha = 0.7, size = 2) +
  facet_wrap(~ Feature, scales = "free_y") +
  stat_pvalue_manual(
    ann_df,
    label = "p.adj.signif",   # use "p.adj" for numeric p-values
