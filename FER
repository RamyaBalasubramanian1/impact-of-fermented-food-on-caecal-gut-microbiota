remove_grubbs_outliers <- function(x) {
  repeat {
    test <- grubbs.test(x)
    p_val <- test$p.value
    if (p_val < 0.05) {
      x <- x[-which.max(abs(x - mean(x, na.rm = TRUE)))]
    } else {
      break
    }
  }
  return(x)
}
clean_result <- long_result %>%
  dplyr::group_by(Week) %>%
  dplyr::mutate(
    is_outlier = Efficiency %in% setdiff(Efficiency, remove_grubbs_outliers(Efficiency))
  ) %>%
  dplyr::filter(!is_outlier) %>%
  dplyr::select(-is_outlier)
#removing the baseline weeks
clean_result <- clean_result %>%
  filter(!(Week %in% c("Week 2", "Week 3")))
