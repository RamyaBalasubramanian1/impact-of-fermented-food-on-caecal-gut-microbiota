  labs(
    title = "Mean Feeding Efficiency Over Time by Diet",
    x = "Week",
    y = "Feeding Efficiency (%)"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))
