data <- weight
data <- data[,-c(2,3,4)]
# Long data with delta vs W1 per animal
delta_long <- data %>%
  pivot_longer(cols = matches("^W\\d+$"),
               names_to = "week", values_to = "weight") %>%
  group_by(Cage.name) %>%
  mutate(delta = weight - weight[week == "W4"]) %>%  # always subtract W1
  ungroup() %>%
  mutate(week_num = as.integer(sub("^W", "", week)),
         weeks_since_baseline = week_num - 1)

# Mean Δ per diet per week (this is the “one line per diet” data)
mean_diet_week <- delta_long %>%
  group_by(diet, weeks_since_baseline) %>%
  summarise(mean_delta = mean(delta, na.rm = TRUE), .groups = "drop")

# Plot: one line per diet
delta_weight_beverage <- ggplot(mean_diet_week,
       aes(x = weeks_since_baseline, y = mean_delta, color = diet)) +
  geom_line(size = 1.1) +
  geom_point(size = 1.6) +
  labs(x = "Weeks since diet switch",
       y = expression( "delta weight gain"),
       color = "Diet") +
  theme_minimal()
######################################
week_cols <- grep("^W\\d+$", names(data), value = TRUE)
week_nums <- as.integer(sub("^W", "", week_cols))
baseline_week <- if ("W4" %in% week_cols) "W4" else paste0("W", min(week_nums))
baseline_num  <- as.integer(sub("^W", "", baseline_week))

# --- 2) Long data + Δ vs baseline (per animal) ---
delta_long <- data %>%
  pivot_longer(all_of(week_cols), names_to = "week", values_to = "weight") %>%
  mutate(week_num = as.integer(sub("^W","", week))) %>%
  group_by(Cage.name) %>%
  mutate(delta = weight - weight[week == baseline_week]) %>%  # ALWAYS vs baseline
  ungroup() %>%
  mutate(weeks_since_baseline = week_num - baseline_num)

# --- 3) One-way ANOVA (per week) on Δ ~ diet ---
anova_by_week <- delta_long %>%
  filter(weeks_since_baseline > 0) %>%             # test weeks after baseline only
  group_split(weeks_since_baseline) %>%
  map_df(~{
    wk <- unique(.x$weeks_since_baseline)
    fit <- aov(delta ~ diet, data = .x)
    broom::tidy(fit) %>%
      filter(term == "diet") %>%
      transmute(
        week_since_baseline = wk,
        df1 = df,
        df2 = fit$df.residual,
        F = statistic,
        p_value = p.value
      )
  }) %>%
  arrange(week_since_baseline) %>%
  mutate(
    p_adj_BH  = p.adjust(p_value, method = "BH"),
    p_adj_Bonf = p.adjust(p_value, method = "bonferroni")
  )

anova_by_week
sig_weeks <- anova_by_week %>% filter(p_adj_BH < 0.05) %>% pull(week_since_baseline)

tukey_by_week <- map_df(sig_weeks, ~{
  df_wk <- filter(delta_long, weeks_since_baseline == .x)
  fit <- aov(delta ~ diet, data = df_wk)
  broom::tidy(TukeyHSD(fit, "diet")) %>%
    mutate(week_since_baseline = .x) %>%
    relocate(week_since_baseline, .before = 1)
})

