n_zeroes <- rowSums(totu == 0)
totu <- totu[n_zeroes <= round(ncol(totu) * 0.90),]
clr <- clr_c(totu)
clr <- as.data.frame(clr)

# Remove columns with all zeros
clr <- clr[, colSums(clr) != 0]
# PCA Analysis
pca <- prcomp(clr, center = FALSE, scale. = FALSE)

# Extract PCA results
pca_df <- as.data.frame(pca$x)  # Principal component scores for samples
pca_df$SampleID <- rownames(pca$x)  # Add sample IDs for reference


# Merge PCA scores with metadata
metadata$SampleID <- rownames(metadata)
pca_merged <- merge(pca_df, metadata, by = "SampleID")

# Calculate % variance explained for labels
variance_explained <- pca$sdev^2 / sum(pca$sdev^2) * 100
pc1_label <- paste0("PC1 (", round(variance_explained[1], 2), "%)")
pc2_label <- paste0("PC2 (", round(variance_explained[2], 2), "%)")


