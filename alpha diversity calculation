sample_data(ps_filtered)$diet <- factor(sample_data(ps_filtered)$diet, levels = c("wk", "fig"))

conds <- as.character(sample_data(ps_filtered)$diet)

aldex2_da <- ALDEx2::aldex(
  data.frame(otu_table(ps_filtered)),
  conds,
  test = "t",
  effect = TRUE,
  denom = "iqlr"
)

ALDEx2::aldex.plot(aldex2_da, type="MW", test="wilcox", called.cex = 1, cutoff = 0.05)#DA plot

########
# Extract and prep taxonomy
tax <- as.data.frame(tax_table(ps_filtered)) %>%
  mutate(OTU = rownames(.)) %>%
  select(OTU, Genus)

# Prep results
df <- as.data.frame(aldex2_da) %>%
  mutate(OTU = rownames(.)) %>%
  left_join(tax, by = "OTU") %>%
  mutate(
    Genus = ifelse(is.na(Genus) | Genus == "", OTU, Genus),
    neglog_p = -log10(wi.ep),
    significant = wi.eBH < 0.05,
    enriched_in = case_when(
      significant & diff.btw > 0 ~ "wk",
      significant & diff.btw < 0 ~ "fig",
      TRUE ~ "NS"
    )
  )
p <- ggplot(df, aes(x = diff.btw, y = neglog_p, label = Genus)) +
  geom_point(aes(color = enriched_in), size = 2, alpha = 0.8) +
  geom_text_repel(
    data = filter(df, enriched_in %in% c("wk", "fig")),
    max.overlaps = 15,
    size = 3
  ) +
  scale_color_manual(
    values = c("wk" = "red", "fig" = "blue", "NS" = "gray"),
    name = "Enriched In"
  ) +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed", color = "black") +
  theme_minimal() +
  labs(
    title = "Taxa Enriched in wk vs fig (ALDEx2)",
    x = "Median Difference (wk - fig)",
    y = "-log10(p-value)"
  )
p <- p + coord_cartesian(clip = "off")
write.csv(df, "C:/Users/Ramya.Balasubramania/Desktop/Thesis_Ramya_2025/chapter_2/Figures/fig_Wk.csv")
ggsave("C:/Users/Ramya.Balasubramania/Desktop/Thesis_Ramya_2025/chapter_2/Figures/DA_wk_fig.svg", plot = p, width = 6, height = 8, units = "in")
