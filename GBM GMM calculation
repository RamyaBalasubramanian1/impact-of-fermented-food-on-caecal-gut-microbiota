# Perform PERMANOVA
adonis_result <- adonis2(ko_clr_filtered ~  fermentation_status, data = metadata_filtered, method = "euclidean")
adonis_result
adonis_result <- adonis2(ko_clr_filtered ~  Diet, data = metadata_filtered, method = "euclidean")
adonis_result
adonis_result <- adonis2(ko_clr_filtered ~  Diet + CageGroup , data = metadata_filtered, method = "euclidean")
adonis_result
adonis_result <- adonis2(ko_clr_filtered ~  Diet , data = metadata_filtered, method = "euclidean")
adonis_result
#note the problem of cage effect
#if you do by ="term" then the factors are treated sequencially, diet explains mst of variation
#but this can be inflated as each animal is treated independently and risk pseudoinflation
#more animals as a result we need to block by cage, cage nested within diet thats why we aggregate
############################

###########################
###########################
# Collapse the CLR-transformed matrix to the cage level
agg_mat <- rowsum(ko_clr_filtered, metadata_filtered$CageGroup) /
  as.vector(table(metadata_filtered$CageGroup))

# Create cage-level metadata
cage_meta <- unique(metadata_filtered[, c("CageGroup", "fermentation_status")])
cage_meta <- cage_meta[match(rownames(agg_mat), cage_meta$CageGroup), , drop = FALSE]

# Run PERMANOVA at the cage level
adonis2(
  agg_mat ~ fermentation_status,
  data = cage_meta,
  method = "euclidean",
  permutations = 999
)
metadata_kc <- metadata[metadata$Diet %in% c("KIM", "CAB"), ]

# Subset KO count table to matching samples
ko_kc <- ko[rownames(metadata_kc), ]


conds <- factor(metadata_kc$diet, levels = c("KIM", "CAB"))
conds <- as.character(metadata_kc$Diet)
ko_kc_t <- t(ko_kc)
ko_kc_int <- round(ko_kc_t)
aldex_kc <- aldex(
  ko_kc_int,
  conds,
  test = "t",
  effect = TRUE,
  denom = "iqlr"
)

# Plot: MA-style volcano with Wilcoxon
aldex.plot(aldex_kc, type = "MW", test = "wilcox", called.cex = 1, cutoff = 0.05)
##############################
unique(conds)#whatever comes first gets positive value
# Add enrichment and significance info
aldex_kc$enriched_in <- ifelse(aldex_kc$we.eBH < 0.05 & aldex_kc$effect > 1, "KIM",
                               ifelse(aldex_kc$we.eBH < 0.05 & aldex_kc$effect < -1, "CAB", "not_sig"))
#none are enriched
