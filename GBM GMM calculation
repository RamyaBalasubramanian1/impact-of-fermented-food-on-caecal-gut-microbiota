gbmko <- read.table("C:/Users/Ramya.Balasubramania/Desktop/Thesis_Ramya_2025/chapter_2/raw_data/pointsix/modules.tsv", header = T)

metadata <- read.table("C:/Users/ramya.Balasubramania/Desktop/animal_studies/mice_teagasc/pilot kimchi and sauerkraut/16s/output272230/meta.tsv" , sep='\t', header=T, row.names=1, comment="")
metadata<- metadata[-c(55:58),]#REMOVING BLANKS AND MOCKS
# Create a new column for cage mate groups
metadata$CageGroup <- gsub("(\\d+[A-Za-z]+)\\d+", "\\1", metadata$Cage)
anno <- read.delim("C:/Users/ramya.Balasubramania/Desktop/animal_studies/mice_teagasc/pilot study kombu and kef/16s/final280180/pathways/annotated_pathways.txt", header = T)
###########################################################################
ko <- gbmko
ko <- as.data.frame(ko)
ko <- column_to_rownames(ko, var = colnames(ko)[1])
ko <- t(ko)
ko <- ko[, grepl("^MGB", colnames(ko)) & as.numeric(sub("MGB", "", colnames(ko))) <= 56]
#Then, remove features that are absent in more than your threshold (90% in this case).
n_zeroes <- rowSums(ko == 0)
ko <- ko[n_zeroes <= round(ncol(ko) * 0.90),]
###########################
# List of samples to remove
samples_to_remove <- c("SKC_55_S55", "Zymo_Mock_S56", "Lib_Neg_S57", "PI_6_S58", 
                       "SKC_13_S13", "SKC_15_S15", "SKC_39_S39", "SKC_40_S40", 
                       "SKC_41_S41", "SKC_42_S42", "SKC_43_S43", "SKC_45_S45", 
                       "SKC_47_S47", "SKC_52_S52")

# Filter out specified samples from the dataset
ko <- ko[!rownames(ko) %in% samples_to_remove, ]
metadata$fermentation_status <- ifelse(metadata$Diet %in% c("CAB", "TM"), "unfermented", "fermented")
zero_variance_cols <- apply(ko, 2, var) == 0
sum(zero_variance_cols)  # Number of constant columns
ko_clr_filtered <- ko[, !zero_variance_cols]
##########################################
##########################################
clr <- clr_c(ko_clr_filtered)
clr <- as.data.frame(clr)

# Remove columns with all zeros
clr <- clr[, colSums(clr) != 0]
# PCA Analysis
pca <- prcomp(clr, center = FALSE, scale. = FALSE)

# Extract PCA results
pca_df <- as.data.frame(pca$x)  # Principal component scores for samples
pca_df$SampleID <- rownames(pca$x)  # Add sample IDs for reference


# Merge PCA scores with metadata
metadata$SampleID <- rownames(metadata)
pca_merged <- merge(pca_df, metadata, by = "SampleID")

# Calculate % variance explained for labels
variance_explained <- pca$sdev^2 / sum(pca$sdev^2) * 100
pc1_label <- paste0("PC1 (", round(variance_explained[1], 2), "%)")
pc2_label <- paste0("PC2 (", round(variance_explained[2], 2), "%)")


r <- ggplot(pca_merged, aes(x = PC1, y = PC2, fill = Diet)) +
  geom_point(
    position = position_jitter(width = 0.1, height = 0.1), 
    size = 4, 
    shape = 21, 
    stroke = 1, 
    color = "black"   # Black outlines for points
  ) +
  stat_ellipse(
    aes(color = Diet, group = Diet), # Ellipse outlines match diet color
    level = 0.95, 
    linewidth = 1
  ) +
  theme_minimal() +
  labs(
    title = "PCA of predicted gbm -fermented",
    x = pc1_label,
    y = pc2_label
  )
ggsave("C:/Users/Ramya.Balasubramania/Desktop/Thesis_Ramya_2025/chapter_2/Figures/gbm_kimsau_pcapointsix.svg", plot = r, width = 12, height = 6, units = "in")



